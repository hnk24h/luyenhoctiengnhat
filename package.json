{
  "name": "luyenthitiengnhat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "ts-node -P tsconfig.seed.json prisma/seed.ts",
    "db:seed-reading": "ts-node -P tsconfig.seed.json prisma/seed-reading.ts",
    "db:seed-minna": "tsx prisma/seed-minna.ts",
    "db:seed-minna-n4": "tsx prisma/seed-minna-n4.ts",
    "db:seed-alphabet": "tsx prisma/seed-alphabet.ts",
    "ollama:gen": "npx tsx prisma/ollama-gen.ts",
    "ollama:lessons": "npx tsx prisma/ollama-gen.ts --mode lessons --dataset ./prisma/data/jlpt-n5-topics.json",
    "ollama:words": "npx tsx prisma/ollama-gen.ts --mode vocab --dataset ./prisma/data/jlpt-n5-words.json",
    "ollama:exam": "npx tsx prisma/ollama-gen.ts --mode questions --dataset ./prisma/data/jlpt-n5-exam.json",
    "ollama:dry": "npx tsx prisma/ollama-gen.ts --mode lessons --dataset ./prisma/data/jlpt-n5-topics.json --dry-run --limit 1",
    "ollama:hsk:lessons": "npx tsx prisma/ollama-gen.ts --mode lessons --dataset ./prisma/data/hsk1-topics.json",
    "ollama:hsk:words": "npx tsx prisma/ollama-gen.ts --mode vocab --dataset ./prisma/data/hsk1-words.json",
    "ollama:hsk:exam": "npx tsx prisma/ollama-gen.ts --mode questions --dataset ./prisma/data/hsk1-exam.json",
    "ollama:pmp:lessons": "npx tsx prisma/ollama-gen.ts --mode lessons --dataset ./prisma/data/pmp-topics.json",
    "ollama:pmp:exam": "npx tsx prisma/ollama-gen.ts --mode questions --dataset ./prisma/data/pmp-exam.json"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.4.1",
    "@prisma/client": "^5.15.0",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "next": "14.2.5",
    "next-auth": "^4.24.7",
    "next-intl": "^3.26.5",
    "papaparse": "^5.5.3",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "reactflow": "^11.11.4",
    "swr": "^2.4.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.4.39",
    "prisma": "^5.15.0",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
